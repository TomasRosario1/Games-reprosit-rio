  <tag k="alt_name" v="Padrão da Batalha de Alvalade"/>
  <tag k="description" v="O Padrão do Campo Pequeno foi erguido, por ordem da Rainha Santa Isabel, no séc. XIV, como atesta uma inscrição que data de cerca de 1323, num local próximo daquele que actualmente ocupa."/>
  <tag k="heritage" v="2"/>
  <tag k="heritage:operator" v="pc"/>
